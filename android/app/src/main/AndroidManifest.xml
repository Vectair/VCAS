<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Phase 1 has no real functionality yet — no location, no network,
         no ADS-B. This manifest exists purely to prove the app registers
         as a car app and launches at all (see CLAUDE.md's "Android Auto —
         native rewrite scoping" note, step 1). ACCESS_FINE_LOCATION /
         ACCESS_BACKGROUND_LOCATION / INTERNET get added in later phases as
         GPS and ADS-B polling actually come online, not before they're
         needed. -->

    <application
        android:allowBackup="false"
        android:label="@string/app_name">

        <!-- Declares this app as a car app, and its category — "navigation"
             is what VCAS actually is (turn-by-turn + a live traffic
             overlay), not "poi"/"parking"/"charging". -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <service
            android:name=".VcasCarAppService"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.NAVIGATION" />
            </intent-filter>
        </service>

    </application>
</manifest>
