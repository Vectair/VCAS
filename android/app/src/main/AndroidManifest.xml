<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Phase 1 has no real functionality yet — no location, no network,
         no ADS-B. This manifest exists purely to prove the app registers
         as a car app and launches at all (see CLAUDE.md's "Android Auto —
         native rewrite scoping" note, step 1). ACCESS_FINE_LOCATION /
         ACCESS_BACKGROUND_LOCATION / INTERNET get added in later phases as
         GPS and ADS-B polling actually come online, not before they're
         needed. -->

    <!-- REQUIRED for the NAVIGATION category specifically (2026-08-25,
         found the hard way — see CLAUDE.md's phase-1 real-device debug
         log): without this, Android Auto doesn't just hide the app, it
         never registers it as a valid car app candidate at all — VCAS was
         absent from BOTH the visible and "Hidden apps" lists on a real
         Kia head unit's launcher customisation screen, not merely sitting
         unchecked in the hidden list. Confirmed via Google's own Car App
         Library navigation-category docs (developer.android.com/training/
         cars/apps/navigation), unreachable directly from this sandbox
         (dl.google.com is blocked) but fetched via WebFetch instead. -->
    <uses-permission android:name="androidx.car.app.NAVIGATION_TEMPLATES"/>

    <application
        android:allowBackup="false"
        android:label="@string/app_name">

        <!-- Declares this app as a car app, and its category — "navigation"
             is what VCAS actually is (turn-by-turn + a live traffic
             overlay), not "poi"/"parking"/"charging". Confirmed current and
             required (2026-08-25) by checking the real, current official
             sample manifest (android/car-samples, car_app_library/
             navigation/mobile/src/main/AndroidManifest.xml) directly — an
             earlier doubt about this being legacy, based on a docs-page
             summary that simply didn't repeat it, was wrong. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <!-- The actual missing piece (2026-08-25) — found by diffing
             against the same official sample manifest above after VCAS was
             confirmed completely invisible to Android Auto's own app scan
             on a real Kia head unit (zero binding attempts, zero log
             activity referencing VCAS's package from Gearhead at all,
             across multiple real-device capture sessions — not merely
             hidden or rejected). Every real sample declares this alongside
             the meta-data above; without it, Android Auto has no minimum
             Car API level to negotiate a session against and apparently
             never even considers the app a candidate. Not yet re-verified
             against the real head unit — update this comment once
             confirmed either way. -->
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="1" />

        <service
            android:name=".VcasCarAppService"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.NAVIGATION" />
            </intent-filter>
        </service>

    </application>
</manifest>
